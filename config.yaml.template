arxiv:
  categories:              # arXiv category codes, see https://arxiv.org/archive
    - "nucl-ex"            # Nuclear experiment
    - "physics.ins-det"    # Instrumentation and detectors
  max_results: 100         # Max papers to fetch per category

#  The below 'interests' field is a free-form text field that can be used to provide additional context to the scoring model. 
#  It accepts natural language text and can be used to specify particular topics, techniques, or areas of interest that are relevant to the user.
#  Hence, use the below field as a chance to tell what you are interested in, as if you were describing your interests to a colleague. 

interests: |               
  I'm fascinated by the intersection of computer vision and robotics. My research focuses on 
developing and refining machine learning-based methods for visual perception and control in 
autonomous systems. Specifically, I'm interested in papers that explore; Visual odometry and 
SLAM (Simultaneous Localization and Mapping) techniques for real-time navigation; Deep 
learning architectures for object detection, tracking, and classification; Computer vision 
applications in robotics, such as grasping, manipulation, and human-robot interaction; Robot 
learning and imitation using vision-based feedback; Sensorimotor integration and planning 
strategies for autonomous systems. I'm less interested in purely theoretical computer science 
papers or those focused on specific robot platforms without broader applicability. 
Additionally, I have a curiosity about applying AI to tackle complex societal challenges, such 
as environmental monitoring or disaster response.

scoring:
  model: "claude-sonnet-4-20250514"   # Claude model to use
  threshold: 7                       # Minimum relevance score (1-10)
  batch_size: 8                      # Pass 2: papers per summarisation call
  score_batch_size: 24               # Pass 1: papers per scoring-only call
  abstract_truncation_words: 150     # Pass 1: max abstract words sent to Claude

digest:
  schedule: "weekly"                 # daily | weekly | fortnightly | monthly
  output_dir: "output"               # Where to save HTML digests
  min_papers_to_email: 3             # Only email once at least N papers are ready
